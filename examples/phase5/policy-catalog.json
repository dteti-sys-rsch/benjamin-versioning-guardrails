{
  "schema_version": 1,
  "evaluator": "Z3 only",
  "query": "facts AND NOT(all applicable constraints)",
  "results": {
    "SAT": "DENY",
    "UNSAT": "candidate ALLOW after prerequisites",
    "UNKNOWN/error/missing/inconsistent": "no ticket"
  },
  "composition": "all applicable constraints; static all-branch plus trusted dynamic dependency union and policy-set membership; hard DENY wins",
  "benchmarks": [
    {
      "policy_id": "no_exfil_after_sensitive",
      "applicability": "external business release; scoped provider exception remains separately authorized",
      "constraints": [
        "no_exfil_after_sensitive",
        "unknown_release",
        "provider_scope"
      ],
      "keys": [
        "exposure:{task}",
        "label:{resource}",
        "document:{resource}",
        "contract3:{task}"
      ],
      "authority": "Gateway/LabelManager/approved contract",
      "transitions": "exposure union before read delivery; owner labels and accepted restrictions remain distinct",
      "evidence": "read intent, content binding, official label, classification proposal/restriction and release intent",
      "limits": "UNKNOWN follows explicit DENY/ESCALATE; classifier PUBLIC and worker claims never declassify"
    },
    {
      "policy_id": "budget_monotone",
      "applicability": "all actions; positive amounts only on spending tools",
      "constraints": [
        "budget_monotone"
      ],
      "keys": [
        "budget:{task}",
        "reserved:{task}",
        "contract3:{task}"
      ],
      "authority": "Gateway/Dispatcher/ContractService",
      "transitions": "reserve at intent, move reserved to used once after receipt; ambiguous outcome retains reservation",
      "evidence": "intent facts and independently persisted receiver receipt",
      "limits": "integer smallest units, nonnegative bounded; no exactly-once provider billing claim"
    },
    {
      "policy_id": "cap_subset",
      "applicability": "managed A tasks",
      "constraints": [
        "scope",
        "agent_scope",
        "parent_scope",
        "agent_membership",
        "parent_budget",
        "parent_execution_caps"
      ],
      "keys": [
        "delegation:{task}:{agent}",
        "agents:{task}",
        "entitlement:{task}:{parent}",
        "taskresolved:{task}",
        "taskmode:{task}",
        "contract3:{task}"
      ],
      "authority": "TaskService/ContractService/TrustedCatalog",
      "transitions": "reviewed relation activation/revocation and aggregate membership version",
      "evidence": "resolved TaskSpec, parent rights and actual per-agent correlated tuples",
      "limits": "reuses Phase 3.6 scope_expression and delegation_constraints, no second capability system in main runtime"
    },
    {
      "policy_id": "recipient_pinned",
      "applicability": "external tools",
      "constraints": [
        "scope",
        "agent_scope",
        "parent_scope",
        "destination_scope"
      ],
      "keys": [
        "contract3:{task}",
        "destination:{recipient}",
        "delegation:{task}:{agent}",
        "entitlement:{task}:{parent}"
      ],
      "authority": "reviewed contract/delegation and admin destination catalog",
      "transitions": "concrete destination is immutable in signed payload and outbox",
      "evidence": "authorized payload hash, accepted intent and applied receiver destination",
      "limits": "cc/bcc/body_ref rejected; no alias/group resolver; unknown destination denied"
    },
    {
      "policy_id": "no_write_after_stale_read",
      "applicability": "update_document",
      "constraints": [
        "no_write_after_stale_read"
      ],
      "keys": [
        "readbasis:{task}:{operation}",
        "document:{resource}",
        "label:{resource}"
      ],
      "authority": "trusted read receiver/RuntimeAuthority/Gateway",
      "transitions": "immutable delivered receipt binds task/agent/resource/version/digest; write advances content and label atomically at intent",
      "evidence": "server read_binding, immutable readbasis and actual document at acceptance",
      "limits": "stale receipt is not renewed by reauthorization; new read and reviewed plan may be required"
    },
    {
      "policy_id": "irreversible_once",
      "applicability": "each task-scoped logical operation ID",
      "constraints": [
        "irreversible_once"
      ],
      "keys": [
        "operation:{task}:{operation}",
        "consent:{task}:{operation}"
      ],
      "authority": "Gateway/ApprovalBroker",
      "transitions": "false to true, unique outbox/task-operation and ticket/nonce consume in same transaction",
      "evidence": "logical operation digest, intent count and separate receiver receipt",
      "limits": "status reread is not new intent; a new ID does not prove a different semantic action; finite-prefix monitor only"
    }
  ],
