# Export variables in the shell. The CLI does not automatically load .env.
OPENAI_API_KEY=REPLACE_IN_LOCAL_ENV_ONLY
OPENAI_MODEL=YOUR_STRUCTURED_OUTPUT_MODEL_ID
GROQ_API_KEY=REPLACE_IN_LOCAL_ENV_ONLY
GROQ_MODEL=openai/gpt-oss-120b
# Direct local Ollama at localhost:11434; no API key. Use an explicit local tag.
OLLAMA_MODEL=qwen3:8b
# Optional trusted local 9Router: select a concrete direct route, disable
# fallback/compression, and bump revision for each routing configuration change.
NINEROUTER_BASE_URL=http://localhost:20128/v1
NINEROUTER_API_KEY=REPLACE_IN_LOCAL_ENV_ONLY
NINEROUTER_MODEL=YOUR_PROVIDER_PREFIX_AND_MODEL_ID
NINEROUTER_UPSTREAM_PROVIDER=YOUR_TRUSTED_UPSTREAM_PROVIDER
NINEROUTER_RESPONSE_MODEL=YOUR_EXACT_RESPONSE_MODEL_ID
NINEROUTER_ROUTE_REVISION=route-v1
TYPESAFE_API_KEY=REPLACE_IN_LOCAL_ENV_ONLY
TYPESAFE_MODEL=jev-1.13.0
